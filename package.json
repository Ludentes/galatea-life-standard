{
  "name": "galatea-life-standard",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "skeleton": "pnpm -r build && pnpm --filter @ludentes/galatea-life-schemas test && python3 conformance/check_manifest.py && python3 -m unittest discover conformance && pnpm --filter @ludentes/galatea-life-harness skeleton"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredOptionalDependencies": [
      "usocket"
    ],
    "overrides": {
      "zigbee-herdsman": "10.10.0"
    }
  }
}
