{
  "name": "@ludentes/galatea-life-harness",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ludentes/galatea-life-standard.git",
    "directory": "conformance/harness"
  },
  "files": [
    "dist",
    "manifests",
    "scripts/with-postgres.mjs",
    "scripts/postgres-profile.mjs"
  ],
  "bin": {
    "galatea-harness": "./dist/cli.js",
    "galatea-with-postgres": "./scripts/with-postgres.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/copy-manifests.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "skeleton": "node dist/skeleton.js"
  },
  "dependencies": {
    "@ludentes/galatea-life-schemas": "workspace:*",
    "@ludentes/galatea-life-sim": "workspace:*",
    "@ludentes/galatea-life-test-clock": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0",
    "mqtt": "5.16.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
