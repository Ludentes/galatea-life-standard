{
  "name": "@ludentes/galatea-life-harness",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ludentes/galatea-life-standard.git",
    "directory": "conformance/harness"
  },
  "files": [
    "dist",
    "manifests",
    "scripts/with-postgres.mjs",
    "scripts/postgres-profile.mjs",
    "scripts/reach.mjs",
    "scripts/changed.mjs",
    "scripts/matrix-timing.mjs"
  ],
  "bin": {
    "galatea-harness": "./dist/cli.js",
    "galatea-with-postgres": "./scripts/with-postgres.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    },
    "./seams/mcp": {
      "types": "./dist/seams/mcp.d.ts",
      "default": "./dist/seams/mcp.js"
    },
    "./reach": {
      "types": "./dist/reach.d.ts",
      "default": "./dist/reach.js"
    },
    "./changed": {
      "types": "./dist/changed.d.ts",
      "default": "./dist/changed.js"
    },
    "./scripts/reach.mjs": "./scripts/reach.mjs",
    "./scripts/changed.mjs": "./scripts/changed.mjs",
    "./scripts/matrix-timing.mjs": "./scripts/matrix-timing.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/copy-manifests.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "skeleton": "node dist/skeleton.js"
  },
  "dependencies": {
    "@ludentes/galatea-life-schemas": "workspace:*",
    "@ludentes/galatea-life-sim": "workspace:*",
    "@ludentes/galatea-life-test-clock": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0",
    "mqtt": "5.16.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
