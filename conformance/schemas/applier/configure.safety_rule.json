{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "applier/configure.safety_rule.json",
  "title": "A configure change's value for kind safety_rule (provisional until the standard names the language): comparisons of the applier's own devices' keys with constants, joined by all and any at most two deep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "trigger",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trigger": {
      "$ref": "#/$defs/expr"
    },
    "conditions": {
      "$ref": "#/$defs/expr"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "action"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          }
        }
      }
    },
    "latch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition"
      ],
      "properties": {
        "condition": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "accepts_other_admins": {
      "type": "boolean"
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "key",
        "op",
        "value"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "group": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/term"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/term"
              }
            }
          }
        }
      ]
    },
    "expr": {
      "oneOf": [
        {
          "$ref": "#/$defs/term"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/term"
                  },
                  {
                    "$ref": "#/$defs/group"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/term"
                  },
                  {
                    "$ref": "#/$defs/group"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
