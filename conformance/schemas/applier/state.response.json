{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "applier/state.response.json",
  "type": "object",
  "required": ["targets", "transports", "latches"],
  "properties": {
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["values", "liveness", "last_check_in", "fresh_s", "fresh_basis", "other_admins"],
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value", "basis_time"],
              "properties": {
                "key": { "type": "string" },
                "value": {},
                "basis_time": { "$ref": "../common.json#/$defs/time" },
                "assumed": { "type": "boolean" }
              }
            }
          },
          "liveness": { "$ref": "../common.json#/$defs/liveness" },
          "last_check_in": { "anyOf": [{ "$ref": "../common.json#/$defs/time" }, { "type": "null" }] },
          "fresh_s": { "type": ["number", "null"] },
          "fresh_basis": { "$ref": "../common.json#/$defs/freshBasis" },
          "other_admins": { "$ref": "../common.json#/$defs/otherAdmins" }
        }
      }
    },
    "transports": { "type": "array" },
    "latches": { "type": "array" }
  }
}
