{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "applier/plan.request.json",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "action", "args", "via", "brain", "for"],
        "properties": {
          "target": { "type": "string" },
          "action": { "type": "string" },
          "args": {},
          "via": { "$ref": "../common.json#/$defs/via" },
          "brain": { "type": "boolean" },
          "for": { "type": "object" },
          "token": { "type": "object" }
        }
      }
    }
  }
}
