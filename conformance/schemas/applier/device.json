{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "applier/device.json",
  "title": "One device in describe.devices",
  "type": "object",
  "required": ["id", "class", "capabilities", "adopted", "feedback", "actions"],
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "class": { "anyOf": [{ "$ref": "../common.json#/$defs/deviceClass" }, { "type": "null" }] },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "sensor_key": { "type": "string" },
    "sensor_keys": { "type": "array", "items": { "type": "string" } },
    "proposed_class": { "anyOf": [{ "$ref": "../common.json#/$defs/deviceClass" }, { "type": "null" }] },
    "class_evidence": { "$ref": "../common.json#/$defs/classEvidence" },
    "protocol": { "$ref": "../common.json#/$defs/protocol" },
    "stable_identifier": { "type": "string" },
    "previous_identifiers": { "type": "array", "items": { "type": "string" } },
    "adopted": { "type": "boolean" },
    "other_admins": { "$ref": "../common.json#/$defs/otherAdmins" },
    "transport": { "type": "string" },
    "bridge_device": { "type": "object", "required": ["bridge", "id"],
      "properties": { "bridge": { "type": "string" }, "id": { "type": "string" } } },
    "reach_s": { "type": "number", "minimum": 0 },
    "feedback": { "$ref": "../common.json#/$defs/feedback" },
    "load": { "$ref": "../common.json#/$defs/load" },
    "max_on_s": { "type": "number", "minimum": 0 },
    "fresh_s": { "type": ["number", "null"] },
    "fresh_slack_s": { "type": "number" },
    "fresh_basis": { "$ref": "../common.json#/$defs/freshBasis" },
    "self_changing": { "type": "array", "items": { "type": "string" } },
    "awaited_keys": { "type": "array", "items": { "type": "string" } },
    "settings": { "type": "array", "items": { "type": "string" } },
    "undescribed": { "type": "array", "maxItems": 32, "items": { "type": "object", "required": ["name", "first_seen"],
      "properties": { "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }, "first_seen": { "type": "string", "format": "date-time" } } } },
    "personal": { "type": "array", "items": { "type": "string" } },
    "infrastructure": { "type": "boolean" },
    "proposed_infrastructure": { "const": true },
    "applier_host": { "type": "boolean" },
    "internal": { "type": "boolean" },
    "wake_via": { "type": "string" },
    "accounts": { "type": "object", "additionalProperties": { "type": "string" } },
    "host": { "type": "string" },
    "plugin": { "type": "string" },
    "version": { "type": "string" },
    "staged_for": { "type": "string" },
    "extensions": { "type": "array", "items": { "type": "object", "required": ["capability"],
            "properties": { "capability": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$" },
              "keys": { "type": "array", "items": { "type": "object", "required": ["key"],
                "properties": { "key": { "type": "string" }, "kind": { "enum": ["state", "event"] } } } } } } },
    "child": { "type": "string" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "tier", "idempotent", "stateless", "ack_within_s"],
        "properties": {
          "action": { "$ref": "../common.json#/$defs/action" },
          "tier": { "$ref": "../common.json#/$defs/tier" },
          "idempotent": { "type": "boolean" },
          "stateless": { "type": "boolean" },
          "toggles": { "type": "boolean" },
          "whole_state": { "type": "boolean" },
          "args": { "type": "object" },
          "tolerance": { "type": "number", "minimum": 0 },
          "ack_within_s": { "type": "number", "minimum": 0 },
          "confirms": { "type": "boolean" },
          "confirmed_by": { "type": "object", "required": ["key", "value"] },
          "tool_hash": { "type": "string" },
          "requested_tier": { "$ref": "../common.json#/$defs/tier" },
          "witness": { "type": "object" }
        }
      }
    }
  }
}
