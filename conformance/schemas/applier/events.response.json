{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "applier/events.response.json",
  "type": "object",
  "required": ["events", "cursor", "notices"],
  "properties": {
    "events": { "type": "array", "items": { "$ref": "event.json" } },
    "cursor": { "type": "string" },
    "notices": { "type": "array", "items": { "$ref": "notice.json" } }
  }
}
