{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "applier/event.json",
  "title": "One event in events and history",
  "type": "object",
  "required": ["seq", "time", "type"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "time": { "$ref": "../common.json#/$defs/time" },
    "type": { "$ref": "../common.json#/$defs/applierEventType" }
  }
}
