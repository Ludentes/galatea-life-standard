{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness/subject.json",
  "title": "subject.json: how the harness starts a subject",
  "type": "object",
  "required": ["standard", "claims", "start"],
  "properties": {
    "standard": { "$ref": "../common.json#/$defs/harnessStandard" },
    "claims": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "start": {
      "type": "object",
      "required": ["command", "ready"],
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "ready": {
          "type": "object",
          "required": ["log"],
          "properties": { "log": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "state_dir": { "type": "boolean" },
    "database": {
      "description": "A Postgres database of its own per test, as GALATEA_DATABASE_URL: true for a fresh one, or an object naming a migrate-only command the harness runs once per run into a template that each test's database is cloned from",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["migrate"],
          "additionalProperties": false,
          "properties": {
            "migrate": {
              "type": "object",
              "required": ["command"],
              "additionalProperties": false,
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      ]
    },
    "stall_tables": {
      "type": "array", "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" }, "minItems": 1,
      "description": "A database subject's tables whose lock stops a safety rule's firing from committing (GA-SAFE-3's crash clause); every table of its schema when absent"
    },
    "mutations": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
  }
}
