{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness/test-control.json",
  "title": "A message on the test transport's control topic, {root}/test/{bridgeId}/control",
  "type": "object",
  "required": ["requestId", "op"],
  "properties": { "requestId": { "type": "string" } },
  "oneOf": [
    { "properties": { "op": { "const": "join" }, "device": { "type": "string", "minLength": 1 },
        "model": { "type": "object" }, "capabilities": { "type": "array", "items": { "type": "string" } },
        "feedback": { "$ref": "../common.json#/$defs/feedback" } },
      "required": ["op", "device", "capabilities", "feedback"] },
    { "properties": { "op": { "const": "report" }, "device": { "type": "string", "minLength": 1 },
        "values": { "type": "object" }, "observedAt": { "$ref": "../common.json#/$defs/wireTime" } },
      "required": ["op", "device", "values", "observedAt"] },
    { "properties": { "op": { "const": "checkIn" }, "device": { "type": "string", "minLength": 1 },
        "at": { "$ref": "../common.json#/$defs/wireTime" } },
      "required": ["op", "device", "at"] },
    { "properties": { "op": { "const": "silence" }, "device": { "type": "string", "minLength": 1 }, "silent": { "type": "boolean" } },
      "required": ["op", "device", "silent"] },
    { "properties": { "op": { "const": "commandResult" }, "device": { "type": "string", "minLength": 1 },
        "result": { "$ref": "../common.json#/$defs/commandResult" },
        "afterMs": { "type": "number", "minimum": 0 }, "reportAfterMs": { "type": "number", "minimum": 0 },
        "detail": { "type": "string" }, "source": { "type": "string" } },
      "required": ["op", "device", "result"] },
    { "properties": { "op": { "const": "commands" }, "subscribed": { "type": "boolean" } },
      "required": ["op", "subscribed"] },
    { "properties": { "op": { "const": "transportState" }, "state": { "$ref": "../common.json#/$defs/transportState" } },
      "required": ["op", "state"] },
    { "properties": { "op": { "const": "link" }, "carrier": { "type": "boolean" }, "gatewayAnswers": { "type": "boolean" } },
      "required": ["op", "carrier", "gatewayAnswers"] },
    { "properties": { "op": { "const": "power" }, "event": { "enum": ["suspend", "resume", "shutdown"] },
        "announced": { "type": "boolean" }, "suspendedMs": { "type": "number", "minimum": 0 } },
      "required": ["op", "event"] },
    { "properties": { "op": { "const": "clock" }, "steppable": { "type": "boolean" } },
      "required": ["op", "steppable"] },
    { "properties": { "op": { "const": "account" }, "osId": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 }, "interactive": { "type": "boolean" },
        "primaryGid": { "type": "integer", "minimum": 0 },
        "path": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "state": { "enum": ["present", "renamed", "deleted", "absent", "lookupFails"] } },
      "required": ["op", "osId", "state"] },
    { "properties": { "op": { "const": "session" }, "id": { "type": "string", "minLength": 1 },
        "osId": { "type": "integer", "minimum": 0 }, "graphical": { "type": "boolean" }, "remote": { "type": "boolean" },
        "seat0Active": { "type": "boolean" }, "state": { "enum": ["active", "locked", "disconnected", "closed"] },
        "idleHint": { "type": "boolean" }, "startedAt": { "$ref": "../common.json#/$defs/wireTime" } },
      "required": ["op", "id", "state"] },
    { "properties": { "op": { "const": "helper" }, "session": { "type": "string", "minLength": 1 },
        "action": { "enum": ["start", "stop", "report", "forge"] },
        "values": { "type": "object", "properties": {
          "activity": { "enum": ["active", "idle"] }, "app": { "type": ["string", "null"] },
          "camera_in_use": { "type": "boolean" }, "microphone_in_use": { "type": "boolean" } },
          "additionalProperties": false },
        "from": { "enum": ["helper", "sessionProcess", "pluginServer"] }, "claims": { "type": "string", "minLength": 1 } },
      "required": ["op", "session", "action"] },
    { "properties": { "op": { "const": "admins" },
        "groups": { "type": "array", "items": { "type": "object", "required": ["name", "gid", "members"], "properties": {
          "name": { "type": "string", "minLength": 1 }, "gid": { "type": "integer", "minimum": 0 },
          "members": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } } },
        "sudo": { "type": "array", "items": { "type": "object", "required": ["osId", "root"], "properties": {
          "osId": { "type": "integer", "minimum": 0 }, "root": { "enum": ["yes", "no", "cannotTell"] } } } },
        "polkit": { "type": "object", "required": ["identities", "unrecognised"], "properties": {
          "identities": { "type": "array", "items": { "type": "string" } }, "unrecognised": { "type": "boolean" } } },
        "reported": { "type": "boolean" } },
      "required": ["op"] },
    { "properties": { "op": { "const": "file" }, "path": { "type": "string", "pattern": "^/" },
        "exists": { "type": "boolean" }, "executable": { "type": "boolean" },
        "writableBy": { "type": "array", "items": { "type": "integer", "minimum": 0 } } },
      "required": ["op", "path"] },
    { "properties": { "op": { "const": "lockBehaviour" }, "session": { "type": "string", "minLength": 1 },
        "result": { "enum": ["locks", "ignores"] }, "afterMs": { "type": "number", "minimum": 0 } },
      "required": ["op", "session", "result"] },
    { "properties": { "op": { "const": "describe" }, "device": { "type": "string", "minLength": 1 },
        "entry": { "type": "object" },
        "bySetting": { "type": "object", "required": ["key", "entries"], "properties": {
          "key": { "type": "string", "minLength": 1 },
          "entries": { "type": "object", "additionalProperties": { "type": "object" } } } },
        "seenMissing": { "type": "array", "items": { "type": "string", "minLength": 1 } } },
      "required": ["op", "device", "entry"] },
    { "properties": { "op": { "const": "interview" }, "device": { "type": "string", "minLength": 1 } },
      "required": ["op", "device"] },
    { "properties": { "op": { "const": "libraryDevice" }, "device": { "type": "string", "minLength": 1 },
        "readings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "means"],
          "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "means": { "enum": ["movement", "presence"] } },
          "additionalProperties": false } } },
      "required": ["op", "device", "readings"] },
    { "properties": { "op": { "const": "setting" }, "device": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean"] }, "observedAt": { "$ref": "../common.json#/$defs/wireTime" } },
      "required": ["op", "device", "key", "value", "observedAt"] },
    { "properties": { "op": { "const": "occur" }, "device": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean"] }, "frameId": { "type": "string", "minLength": 1 },
        "observedAt": { "$ref": "../common.json#/$defs/wireTime" } },
      "required": ["op", "device", "key", "value", "frameId", "observedAt"] },
    { "properties": { "op": { "const": "undescribed" }, "device": { "type": "string", "minLength": 1 },
        "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } },
      "required": ["op", "device", "names"] },
    { "properties": { "op": { "const": "admit" }, "device": { "type": "string", "minLength": 1 },
        "how": { "$ref": "../common.json#/$defs/admission" } },
      "required": ["op", "device", "how"] },
    { "properties": { "op": { "const": "leave" }, "device": { "type": "string", "minLength": 1 } },
      "required": ["op", "device"] },
    { "properties": { "op": { "const": "windowState" }, "open": { "type": "boolean" } },
      "required": ["op", "open"] },
    { "properties": { "op": { "const": "protocolResult" }, "device": { "type": "string", "minLength": 1 },
        "result": { "$ref": "../common.json#/$defs/protocolResult" }, "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "detail": { "type": "string" } },
      "required": ["op", "device", "result"],
      "allOf": [
        { "if": { "properties": { "result": { "const": "notSent" } } },
          "then": { "properties": { "reason": { "enum": ["unreachable", "expired"] } } } },
        { "if": { "properties": { "result": { "const": "refused" } } },
          "then": { "properties": { "reason": { "not": { "enum": ["unreachable", "unknown_device", "invalid_request", "expired", "no_confirmation"] } } } } },
        { "if": { "properties": { "result": { "enum": ["confirmed", "transmitted", "lost"] } } },
          "then": { "not": { "required": ["reason"] } } }
      ] },
    { "properties": { "op": { "const": "hostLink" }, "open": { "type": "boolean" }, "answers": { "type": "boolean" } },
      "required": ["op", "open", "answers"] },
    { "properties": { "op": { "const": "stateMismatch" }, "disagrees": { "type": "boolean" } },
      "required": ["op", "disagrees"] },
    { "properties": { "op": { "const": "reporting" }, "device": { "type": "string", "minLength": 1 },
        "configuredMs": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "modelMs": { "type": ["number", "null"], "exclusiveMinimum": 0 } },
      "required": ["op", "device", "configuredMs", "modelMs"] },
    { "properties": { "op": { "const": "foreignBinding" }, "device": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 } },
      "required": ["op", "device", "target"] },
    { "properties": { "op": { "const": "classFrom" }, "device": { "type": "string", "minLength": 1 },
        "proposedClass": { "$ref": "../common.json#/$defs/deviceClass" }, "from": { "enum": ["device", "modelDb", "guess"] } },
      "required": ["op", "device", "proposedClass", "from"] },
    { "properties": { "op": { "const": "nativeControl" }, "way": { "type": "string", "minLength": 1 },
        "canDisable": { "type": "boolean" } },
      "required": ["op", "way", "canDisable"] },
    { "properties": { "op": { "const": "lockPin" }, "device": { "type": "string", "minLength": 1 },
        "requiresPin": { "type": "boolean" }, "pin": { "type": "string", "minLength": 1 } },
      "required": ["op", "device", "requiresPin"] },
    { "properties": { "op": { "const": "stall" }, "ms": { "type": "number", "minimum": 0 } },
      "required": ["op", "ms"] }
  ]
}
