  "actions": [{ "target": "sim-bridge:laptop", "action": "session.lock", "args": { "account": "liza" } }],
  "active": true,
  "exceptions": [{ "from": "2030-01-01T21:00:00+03:00", "until": "2030-01-01T21:30:00+03:00" }]
}
